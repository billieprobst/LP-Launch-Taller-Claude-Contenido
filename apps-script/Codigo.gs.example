/* ================================================================
   INMOESCALA CLUB — Backend (Google Apps Script)
   - Guarda cada registro en el Google Sheet
   - Envía email de bienvenida con el enlace del grupo (vía Resend)

   NOTA sobre Pancake CRM: soporte de Pancake confirmó que su API solo
   se conecta con el ecosistema propio (Google Sheets, Wercake, etc.),
   no con plataformas externas. Por eso este Sheet ES el punto de
   conexión: se configura la importación desde Google Sheets dentro
   de Pancake (Configuración → Conectar), sin necesitar código extra.
   ================================================================

   CÓMO INSTALAR (ver README.md para el detalle):
   1. Crea un Google Sheet nuevo. Copia su ID de la URL:
      https://docs.google.com/spreadsheets/d/ESTO_ES_EL_ID/edit
   2. Extensiones → Apps Script. Pega este archivo completo.
   3. Rellena las constantes de CONFIG de abajo.
   4. Implementar → Nueva implementación → Aplicación web:
        - Ejecutar como: Yo
        - Quién tiene acceso: Cualquier usuario
      Copia la URL /exec y pégala en assets/js/main.js (APPS_SCRIPT_URL).
   5. Ejecuta una vez la función "setup" para crear los encabezados.
   ================================================================ */

const CONFIG = {
  SHEET_ID: "1kOmvlU3JFswr07vRd4_3wTMEx6tbncGcepUlR_jCbwc",
  SHEET_NAME: "Registros",

  RESEND_API_KEY: "PEGAR_API_KEY_DE_RESEND",
  // El dominio verificado en Resend es club.inmoescala.com (no inmoescala.com a secas)
  FROM_EMAIL: "Inmoescala <registro@club.inmoescala.com>",
  REPLY_TO: "registro@club.inmoescala.com",

  WHATSAPP_GROUP: "https://chat.whatsapp.com/ITDVWsMDcHaIc5t96VjvVS",
  LAUNCH_TEXT: "8 de octubre, 6:00 pm (Ecuador · Colombia · Perú)",

  // Logo hosteado en la landing publicada (los emails no pueden usar archivos locales)
  LOGO_URL: "https://lp-launch-taller-claude-contenido.vercel.app/assets/img/logo-club-banner.png",
};

const HEADERS = [
  "Fecha", "Nombre", "WhatsApp", "Email", "Instagram",
  "Rol", "Rol_otro", "Antiguedad", "Reto_contenido", "Interes", "Inversion",
  "UTM_source", "UTM_medium", "UTM_campaign", "UTM_content", "UTM_term",
  "User_agent", "Pagina", "Email_enviado",
];

/* ---------- Ejecutar una vez a mano para preparar la hoja ---------- */
function setup() {
  const sh = getSheet_();
  if (sh.getLastRow() === 0) {
    sh.appendRow(HEADERS);
    sh.setFrozenRows(1);
  }
  Logger.log("Hoja lista: " + sh.getName());
}

/* ---------- Endpoint POST ---------- */
function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    const sh = getSheet_();
    if (sh.getLastRow() === 0) { sh.appendRow(HEADERS); sh.setFrozenRows(1); }

    let emailStatus = "no";
    try {
      if (data.email) { sendWelcomeEmail_(data); emailStatus = "si"; }
    } catch (mailErr) {
      emailStatus = "error: " + mailErr;
    }

    sh.appendRow([
      data.fecha || new Date().toISOString(),
      data.nombre || "",
      data.whatsapp || "",
      data.email || "",
      data.instagram || "",
      data.rol || "",
      data.rol_otro || "",
      data.antiguedad || "",
      data.reto_contenido || "",
      data.interes || "",
      data.inversion || "",
      data.utm_source || "",
      data.utm_medium || "",
      data.utm_campaign || "",
      data.utm_content || "",
      data.utm_term || "",
      data.user_agent || "",
      data.pagina || "",
      emailStatus,
    ]);

    return json_({ ok: true });
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}

function doGet() {
  return json_({ ok: true, msg: "Inmoescala Club endpoint activo" });
}

/* ---------- Helpers ---------- */
function getSheet_() {
  const ss = SpreadsheetApp.openById(CONFIG.SHEET_ID);
  return ss.getSheetByName(CONFIG.SHEET_NAME) || ss.insertSheet(CONFIG.SHEET_NAME);
}

function json_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

/* ---------- Email de bienvenida vía Resend ---------- */
function sendWelcomeEmail_(data) {
  const nombre = (data.nombre || "").split(" ")[0] || "";
  const html = welcomeHtml_(nombre);

  const res = UrlFetchApp.fetch("https://api.resend.com/emails", {
    method: "post",
    contentType: "application/json",
    headers: { Authorization: "Bearer " + CONFIG.RESEND_API_KEY },
    muteHttpExceptions: true,
    payload: JSON.stringify({
      from: CONFIG.FROM_EMAIL,
      to: [data.email],
      reply_to: CONFIG.REPLY_TO,
      subject: "✅ Estás dentro — tu acceso al grupo de Inmoescala Club",
      html: html,
    }),
  });

  const code = res.getResponseCode();
  if (code >= 300) {
    throw new Error("Resend " + code + ": " + res.getContentText());
  }
}

function welcomeHtml_(nombre) {
  const saludo = nombre ? ("¡Hola " + nombre + "!") : "¡Hola!";
  return `
  <!DOCTYPE html>
  <html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background:#f5f8fd;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f8fd;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                 style="max-width:520px;background:#ffffff;border-radius:20px;overflow:hidden;
                        box-shadow:0 10px 30px rgba(19,34,86,.12);">

            <!-- Header con logo -->
            <tr>
              <td align="center" style="background:#ffffff;padding:28px 24px;border-bottom:1px solid #e6ebf4;">
                <img src="${CONFIG.LOGO_URL}" alt="Inmoescala Club" width="220" style="display:block;">
              </td>
            </tr>

            <!-- Cuerpo -->
            <tr>
              <td style="padding:32px 28px 8px;">
                <p style="margin:0 0 18px;font-size:20px;font-weight:700;color:#132256;">
                  ${saludo}
                </p>
                <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#1f2430;">
                  ¡Felicidades! Tu registro al <strong>Taller de Vende Propiedades en Redes
                  Sociales con Claude</strong> está confirmado. Este es tu acceso directo al
                  grupo privado de WhatsApp donde compartiremos toda la información del
                  Taller Gratuito.
                </p>
              </td>
            </tr>

            <!-- Botón CTA -->
            <tr>
              <td align="center" style="padding:0 28px 28px;">
                <a href="${CONFIG.WHATSAPP_GROUP}"
                   style="background:#ff6a1f;color:#ffffff;text-decoration:none;font-weight:bold;
                          font-size:15px;padding:15px 32px;border-radius:999px;display:inline-block;">
                  👉 Entrar al grupo de WhatsApp
                </a>
              </td>
            </tr>

            <!-- Fecha destacada -->
            <tr>
              <td style="padding:0 28px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background:#f5f8fd;border-radius:14px;">
                  <tr>
                    <td style="padding:16px 20px;">
                      <p style="margin:0;font-size:14px;color:#454f6b;">
                        📅 <strong style="color:#132256;">Taller Gratuito en vivo:</strong>
                        8 de octubre, 6:00 pm<br>
                        <span style="font-size:13px;color:#7a869e;">(Ecuador · Colombia · Perú)</span>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Regalos + sorteo -->
            <tr>
              <td style="padding:0 28px 8px;">
                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#1f2430;">
                  Al unirte al grupo aseguras tu lugar para recibir tus
                  <strong>7 regalos exclusivos</strong> el día del evento, y quedas
                  participando en el sorteo de una
                  <strong>auditoría de perfil y contenido de Instagram</strong>.
                </p>
                <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#1f2430;">
                  Dentro del grupo te compartiremos recordatorios, contenido de valor y el
                  enlace de acceso el día del Taller.
                </p>
                <p style="margin:0 0 4px;font-size:15px;line-height:1.6;color:#1f2430;">
                  ¿Tienes dudas? Escríbenos por Instagram:
                  <a href="https://instagram.com/billieprobst" style="color:#0f7fc4;">@billieprobst</a>.
                </p>
              </td>
            </tr>

            <!-- Firma -->
            <tr>
              <td style="padding:8px 28px 28px;">
                <p style="margin:0;font-size:15px;line-height:1.6;color:#1f2430;">
                  Nos vemos dentro,<br>
                  <strong style="color:#132256;">Billie Probst</strong><br>
                  <span style="font-size:13px;color:#7a869e;">Fundador de Inmoescala Club</span>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:20px 28px;background:#f5f8fd;border-top:1px solid #e6ebf4;">
                <p style="margin:0;font-size:12px;color:#7a869e;text-align:center;">
                  Recibes este correo porque te registraste en la landing de Inmoescala Club.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
  </html>`;
}
